{
  "name": "cortex-core",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @cortex/web dev",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @cortex/web build && node tools/check-budgets.mjs",
    "preview": "pnpm --filter @cortex/web preview",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "assets:optimize": "pnpm --filter @cortex/asset-pipeline optimize",
    "data:validate": "node tools/data-import/validate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:production": "node tools/verify-production.mjs",
    "verify:3d": "node tools/verify-reconstruction.mjs",
    "desktop:dev": "pnpm --filter @cortex/desktop dev",
    "desktop:build": "pnpm --filter @cortex/desktop build",
    "desktop:check": "pnpm --filter @cortex/desktop check:rust",
    "desktop:test": "pnpm --filter @cortex/desktop test:rust",
    "test:desktop": "node tools/desktop/smoke.mjs",
    "desktop:package": "pnpm desktop:build && node tools/desktop/package-release.mjs"
  },
  "dependencies": {
    "@cortex/part-schema": "workspace:*",
    "@cortex/compatibility-engine": "workspace:*",
    "@cortex/asset-runtime": "workspace:*",
    "@cortex/data-access": "workspace:*",
    "@cortex/3d-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "@types/node": "26.6.4",
    "@electric-sql/pglite": "0.5.8",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "prettier": "3.9.9"
  }
}
